PORT=5000

# Comma-separated exact frontend origins allowed to call this API. The first
# origin is used for OAuth redirects and password-reset links.
# Example: https://greathire-teamora-deployment-vercel.vercel.app,http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173

# --- MongoDB Atlas (live cloud DB) ---
# Replace this with your real Atlas connection string.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# MONGODB_DB_NAME=teamora

# --- Shared conversation file storage (S3-compatible object storage) ---
# Keep these secrets on the backend only. For Cloudflare R2, set S3_ENDPOINT
# to the account's S3 API endpoint and S3_REGION=auto. For AWS S3, leave the
# endpoint blank and use the bucket's AWS region.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Set to "false" after your first successful run if you don't want the demo
# employees/attendance/leave/etc re-seeded every time the DB is empty.
SEED_DEMO_DATA=true

# --- Auth (JWT) ---
# Change this to a long random string before deploying anywhere real.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
JWT_REMEMBER_ME_EXPIRES_IN=30d

JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_REMEMBER_ME_EXPIRES_IN=60d

# Password every seeded demo user (see src/data/usersStore.js) can log in with.
SEED_USER_PASSWORD=password123

# --- OAuth (optional) ---
# "Continue with Google/Microsoft" on the login page only works once these are set.
# Leave blank to keep those buttons disabled — everything else still works fine.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=

# --- Email sending (forgot/reset password emails) ---
# Option 1 (Recommended for Serverless / Cloud): Brevo HTTPS API (port 443 — no SMTP blocking)
# 300 free emails/day, works with any gmail address without needing a custom domain:
BREVO_API_KEY=
BREVO_FROM_EMAIL=Teamora <your-email@gmail.com>

# Option 2: Resend HTTPS API (port 443)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Option 3: Gmail SMTP (works in local dev or hosting where SMTP ports 25, 465, 587 are open):
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM_EMAIL=
